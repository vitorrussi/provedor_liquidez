# Obtenha uma API key gratuita em https://thegraph.com/studio/ (crie uma conta,
# vá em "API Keys" — o free tier cobre uso de desenvolvimento/teste tranquilamente)
GRAPH_API_KEY=

# Normalmente não precisa mexer — já apontam para os subgraphs oficiais da Uniswap v2/v3/v4 mainnet
UNISWAP_V2_SUBGRAPH_ID=A3Np3RQbaBA6oKJgiwDJeo5T3zrYfGHPWFYayMwtNDum
UNISWAP_V3_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
UNISWAP_V4_SUBGRAPH_ID=DiYPVdygkfjDWhbxGSqAQxwBKmfKnkWQojqeM2rkLb3G

# Aerodrome Slipstream (Base) -- subgraph comunitário, não publicado pela
# Aerodrome (sem SLA), mas verificado ativo/consistente em 2026-09-09. Ver
# CLAUDE.md, seção "Aerodrome Slipstream (Base)".
AERODROME_SLIPSTREAM_SUBGRAPH_ID=GENunSHWLBXm59mBSgPzQ8metBEp9YDfdqwFr91Av1UM

# RPCs públicos usados só pra verificar o TVL de um pool via saldo real
# on-chain (ver CLAUDE.md, seção "TVL do subgraph pode estar errado"). Não
# precisam de API key. Se ficarem instáveis, troque por um endpoint próprio
# (Infura/Alchemy free tier já bastam). eth_rpc_url é Ethereum mainnet
# (v2/v3/v4); base_rpc_url é Base mainnet (Aerodrome Slipstream) -- são
# chains diferentes.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org

CORS_ORIGINS=["http://localhost:5173"]
