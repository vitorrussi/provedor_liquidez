# RPC Ethereum público usado só pra verificar o TVL de um pool via saldo real
# on-chain (ver CLAUDE.md, seção "TVL do subgraph pode estar errado"). Não
# precisa de API key. Se ficar instável, troque por um endpoint próprio
# (Infura/Alchemy free tier já bastam).
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

CORS_ORIGINS=["http://localhost:5173"]
